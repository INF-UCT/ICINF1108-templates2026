# Copia este archivo como `.env` para cambiar los valores por defecto.
# docker compose lee `.env` automáticamente.

# Puerto de la API en el host
APP_PORT=3000

# PostgreSQL (servicio `db` de docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=icinf1108
DB_PORT=5432

# Solo si corres la API fuera de Docker (pnpm run start:dev).
# Dentro de Docker, docker-compose.yml arma esta URL apuntando al host `db`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/icinf1108

# Crea/actualiza las tablas desde las entidades al iniciar (desactívalo en producción)
DATABASE_SYNCHRONIZE=true

# Secreto para firmar la cookie de sesión. Usa un valor largo y aleatorio.
SESSION_SECRET=cambia-este-secreto-en-produccion

# Duración de la sesión en milisegundos (8 horas)
SESSION_MAX_AGE_MS=28800000

# true solo si la app se sirve por HTTPS
SESSION_COOKIE_SECURE=false
