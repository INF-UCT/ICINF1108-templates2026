# Copia este archivo como `.env` para cambiar los valores por defecto.
# docker compose lee `.env` automáticamente.

# Puerto de la API en el host
APP_PORT=3000

# PostgreSQL (servicio `db` de docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=icinf1108
DB_PORT=5432

# Al correr la API fuera de Docker (dotnet run), la conexión se toma de
# appsettings.json (ConnectionStrings:Default) o de esta variable:
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=icinf1108;Username=postgres;Password=postgres

# Duración de la sesión en minutos (8 horas)
# Session__MaxAgeMinutes=480

# true solo si la app se sirve por HTTPS
# Session__CookieSecure=false
